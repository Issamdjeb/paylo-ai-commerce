# API server local configuration (copy to artifacts/api-server/.env)
NODE_ENV=development
PORT=5000
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET_KEY=
OPENROUTER_API_KEY=
# Optional server-side model routing. Use comma-separated OpenRouter model IDs.
OPENROUTER_MODELS=
OPENROUTER_VISION_MODELS=
GEMINI_API_KEY=
ADMIN_EMAILS=
CORS_ALLOWED_ORIGINS=
# Local-only convenience; keep false in production.
AUTH_ALLOW_DEV_FALLBACK=false
# Optional: set only if you have verified PayPal Sandbox subscription plan IDs.
PAYPAL_PLAN_COMMUNITY_MONTHLY=
PAYPAL_PLAN_COMMUNITY_YEARLY=
PAYPAL_PLAN_FEATURED_MONTHLY=
PAYPAL_PLAN_FEATURED_YEARLY=
PAYPAL_PLAN_PREMIUM_MONTHLY=
PAYPAL_PLAN_PREMIUM_YEARLY=
# Optional sign-in configuration. Use a separate demo Supabase project for the
# hackathon deployment, never the production AItools Hubi project.
SUPABASE_URL=
SUPABASE_ANON_KEY=
